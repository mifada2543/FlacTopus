# Blokir akses langsung ke folder controller
# Hanya folder api/ yang boleh diakses via web
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Tolak akses ke logic/ dan file PHP lain di controller/
    RewriteRule ^(logic|autoloader\.php)(/|$) - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    # Tolak akses ke semua file PHP kecuali yang diizinkan
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
    # Izinkan .htaccess itu sendiri
    <FilesMatch "^\.htaccess$">
        Require all granted
    </FilesMatch>
</IfModule>
