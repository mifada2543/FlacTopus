# ============================================================
# storage/chat/.htaccess — blokir akses langsung ke chat history
# ============================================================
# Folder ini berisi JSON chat history per murid/guru.
# File hanya boleh dibaca/ditulis oleh PHP (backend/controller/api/quiz.php).
# TIDAK boleh diakses langsung lewat browser.
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
